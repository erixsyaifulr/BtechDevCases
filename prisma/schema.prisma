datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  balance   Float    @default(100000)
  createdAt DateTime @default(now())
}

model Transaction {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  amount      Float
  notes       String?
  createdAt   DateTime @default(now())
}
